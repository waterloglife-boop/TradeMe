{
  "manifest_version": 3,
  "name": "트레이드미 - 배민·쿠팡·요기요·네이버플레이스 AI 리뷰 비서",
  "version": "1.4.3",
  "description": "배달의민족, 쿠팡이츠, 요기요, 네이버 스마트플레이스 사장님을 위한 1초 맞춤형 AI 리뷰 답글 자동완성 비서 (트레이드미 회원 전용)",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://ekpitdijyfnsjhdpaqde.supabase.co/*",
    "https://*.supabase.co/*",
    "https://trade-me-seven.vercel.app/*",
    "*://ceo.baemin.com/*",
    "*://self.baemin.com/*",
    "*://owner.baemin.com/*",
    "*://*.baemin.com/*",
    "*://store.coupangeats.com/*",
    "*://merchant.coupangeats.com/*",
    "*://*.coupangeats.com/*",
    "*://owner.yogiyo.co.kr/*",
    "*://ceo.yogiyo.co.kr/*",
    "*://partner.yogiyo.co.kr/*",
    "*://*.yogiyo.co.kr/*",
    "*://smartplace.naver.com/*",
    "*://new.smartplace.naver.com/*",
    "*://*.smartplace.naver.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://ceo.baemin.com/*",
        "*://self.baemin.com/*",
        "*://owner.baemin.com/*",
        "*://*.baemin.com/*",
        "*://store.coupangeats.com/*",
        "*://merchant.coupangeats.com/*",
        "*://*.coupangeats.com/*",
        "*://owner.yogiyo.co.kr/*",
        "*://ceo.yogiyo.co.kr/*",
        "*://partner.yogiyo.co.kr/*",
        "*://*.yogiyo.co.kr/*",
        "*://smartplace.naver.com/*",
        "*://new.smartplace.naver.com/*",
        "*://*.smartplace.naver.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
